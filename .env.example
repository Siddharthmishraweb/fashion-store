# Base URL of the API in server/. Ignored when USE_MOCK is true.
# Same-origin proxy in development (`/api` → :4000). In production set the
# public API origin, e.g. https://api.vastrika.market
VITE_API_URL=/api

# Vault override. true = in-browser mock. false = real API at VITE_API_URL.
# If unset, src/config/vault.js USE_MOCK is used.
VITE_USE_MOCK=false

VITE_APP_NAME=Vastrika
VITE_PLATFORM_DOMAIN=vastrika

# Optional: unsigned Cloudinary uploads when VITE_USE_MOCK=true (GitHub Pages).
# Create a cloud at https://cloudinary.com and an unsigned upload preset.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

