# Base URL of the API in server/. Leave empty to fall back to the in-browser
# mock, which lets the UI run with no backend at all.
# Same-origin proxy in development (`/api` → :4000). In production set the
# public API origin, e.g. https://api.vastrika.market
VITE_API_URL=/api

# Set to false to talk to the real API. Any other value keeps the mock active.
VITE_USE_MOCK=false

VITE_APP_NAME=Vastrika
VITE_PLATFORM_DOMAIN=vastrika
