# ---------------------------------------------------------------- runtime
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info

# Comma-separated list of origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# ---------------------------------------------------------------- database
DATABASE_URL=postgres://vastrika:vastrika@localhost:5432/vastrika
# Pool size per process. Keep (PG_POOL_MAX * instances) below Postgres max_connections.
PG_POOL_MAX=12
PG_IDLE_TIMEOUT=30
PG_CONNECT_TIMEOUT=10

# ---------------------------------------------------------------- security
# 64+ random hex chars. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=change-me-to-a-long-random-value-before-deploying-anywhere
SESSION_TTL_HOURS=8
# Failed logins allowed per email+IP before a temporary lock.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=5

# Requests per window per caller. The global budget covers storefront reads; the
# credential routes get the tighter one. Raise these only for load testing.
RATE_LIMIT_MAX=600
RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# ---------------------------------------------------------------- caching
# Seconds that public storefront reads may be served from the in-process cache.
CACHE_TTL_SECONDS=30
CACHE_MAX_ENTRIES=5000
# Value sent in Cache-Control: public, max-age=... for storefront GETs.
HTTP_CACHE_SECONDS=15
